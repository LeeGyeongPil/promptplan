# Copy to .env and fill in, then: npx promptplan plan --env-file .env
# Keys: Langfuse project settings → API keys. Never commit the real .env.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# EU cloud (default). US: https://us.cloud.langfuse.com · self-hosted: your own URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
